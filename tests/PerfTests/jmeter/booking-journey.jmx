          <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think: fill in the quote form">
            <intProp name="ActionProcessor.action">1</intProp>
            <intProp name="ActionProcessor.target">0</intProp>
            <stringProp name="ActionProcessor.duration">${THINK_HOME_MS}</stringProp>
          </TestAction>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Gets a quote? (85%)" enabled="true">
            <stringProp name="IfController.condition">${__jexl3(${funnel} &gt; ${QUOTE_ABOVE})}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
