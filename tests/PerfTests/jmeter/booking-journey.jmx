          </IfController>
          <hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="T02_GetPlanOptions">
              <boolProp name="TransactionController.includeTimers">false</boolProp>
            </TransactionController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T02_CreateQuote">
                <stringProp name="HTTPSampler.path">/api/Quotes/create</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{&quot;ProductCode&quot;:&quot;ST&quot;,&quot;BaseCountry&quot;:&quot;NZL&quot;,&quot;StartDateOfJourney&quot;:&quot;${journeyStart}T00:00:00.000Z&quot;,&quot;StartDateOfInsurance&quot;:&quot;${insuranceStart}T00:00:00.000Z&quot;,&quot;EndDate&quot;:&quot;${journeyEnd}T00:00:00.000Z&quot;,&quot;Destinations&quot;:[${destinations}],&quot;AdultsAge&quot;:[${adultAges}],&quot;NonDependentChildAges&quot;:[${nonDependentAges}],&quot;DependentChildAges&quot;:[${dependentAges}],&quot;ChildAges&quot;:[]}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Travel dates from today in New Zealand" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">// The site works in New Zealand dates, whatever time zone the load generator uses.
def today = java.time.LocalDate.now(java.time.ZoneId.of(&apos;Pacific/Auckland&apos;))
vars.put(&apos;insuranceStart&apos;, today.toString())
vars.put(&apos;journeyStart&apos;, today.plusDays(vars.get(&apos;startOffset&apos;) as long).toString())
vars.put(&apos;journeyEnd&apos;, today.plusDays(vars.get(&apos;endOffset&apos;) as long).toString())</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep quote ids and default options" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">if (prev.getResponseCode() != &apos;200&apos;) {
    return
}
def quote = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def premium = quote.Premiums.find { it.PolicyTypeCode == &apos;ST&apos; } ?: quote.Premiums[0]
vars.put(&apos;quoteId&apos;, quote.QuoteId as String)
vars.put(&apos;policyNumber&apos;, quote.PolicyNumber as String)
// Shown as &quot;$200&quot; and &quot;$2,500&quot;; the API takes &quot;200&quot; and &quot;2500&quot;.
vars.put(&apos;defaultExcess&apos;, (premium.SelectedExcess as String).replaceAll(&apos;[$,]&apos;, &apos;&apos;))
vars.put(&apos;defaultCancellation&apos;, (premium.SelectedCancellationCover as String).replaceAll(&apos;[$,]&apos;, &apos;&apos;))</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="API headers" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Content-Type</stringProp>
                      <stringProp name="Header.value">application/json</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Accept</stringProp>
                      <stringProp name="Header.value">*/*</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Origin</stringProp>
                      <stringProp name="Header.value">https://${HOST}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Referer</stringProp>
                      <stringProp name="Header.value">https://${HOST}/</stringProp>
                    </elementProp>
                  </collectionProp>
                </HeaderManager>
                <hashTree/>
                <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Quote created" enabled="true">
                  <stringProp name="JSON_PATH">$.IsSuccess</stringProp>
                  <stringProp name="EXPECTED_VALUE">true</stringProp>
                  <boolProp name="JSONVALIDATION">true</boolProp>
                  <boolProp name="EXPECT_NULL">false</boolProp>
                  <boolProp name="INVERT">false</boolProp>
                  <boolProp name="ISREGEX">false</boolProp>
                </JSONPathAssertion>
                <hashTree/>
                <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Has a quote id" enabled="true">
                  <stringProp name="JSON_PATH">$.QuoteId</stringProp>
