              <hashTree/>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extra cover flags" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def extra = vars.get(&apos;extra&apos;)
vars.put(&apos;skiCover&apos;, String.valueOf(extra == &apos;Ski&apos;))
vars.put(&apos;cruiseCover&apos;, String.valueOf(extra == &apos;Cruise&apos;))
vars.put(&apos;mopedCover&apos;, String.valueOf(extra == &apos;Moped&apos;))</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think: choose discount" enabled="true">
                <intProp name="ActionProcessor.action">1</intProp>
                <intProp name="ActionProcessor.target">0</intProp>
                <stringProp name="ActionProcessor.duration">${THINK_CHANGE_MS}</stringProp>
              </TestAction>
              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="T03_UpdateExtras" enabled="true">
                <stringProp name="TestPlan.comments">1 of 4: discount</stringProp>
                <stringProp name="HTTPSampler.path">/api/Quotes/extras</stringProp>
                <stringProp name="HTTPSampler.method">PUT</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{&quot;QuoteId&quot;:&quot;${quoteId}&quot;,&quot;PolicyNumber&quot;:&quot;${policyNumber}&quot;,&quot;Excess&quot;:&quot;${defaultExcess}&quot;,&quot;CancellationCover&quot;:&quot;${defaultCancellation}&quot;,&quot;ProductCode&quot;:&quot;ST&quot;,&quot;SchsDiscount&quot;:${discount},&quot;MopedCover&quot;:false,&quot;CruiseCover&quot;:false,&quot;SkiCover&quot;:false}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree/>
              <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think: choose excess" enabled="true">
                <intProp name="ActionProcessor.action">1</intProp>
                <intProp name="ActionProcessor.target">0</intProp>
                <stringProp name="ActionProcessor.duration">${THINK_CHANGE_MS}</stringProp>
              </TestAction>
              <hashTree/>
