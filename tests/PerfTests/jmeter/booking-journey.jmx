              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Same quote, priced">
                <stringProp name="JSON_PATH">$.QuoteId</stringProp>
                <stringProp name="EXPECTED_VALUE">${quoteId}</stringProp>
                <boolProp name="JSONVALIDATION">true</boolProp>
