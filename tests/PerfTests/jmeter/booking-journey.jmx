          <stringProp name="randomSeed"></stringProp>
          <boolProp name="perThread">false</boolProp>
        </RandomVariableConfig>
        <hashTree/>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Journey cap (max.journeys)" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(${__counter(FALSE,)} &lt;= ${__P(max.journeys,1000000000)})}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="T01_Home">
            <boolProp name="TransactionController.includeTimers">false</boolProp>
