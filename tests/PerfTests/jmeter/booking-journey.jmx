                      <stringProp name="Argument.value">{&quot;QuoteId&quot;:&quot;${quoteId}&quot;,&quot;PolicyNumber&quot;:&quot;${policyNumber}&quot;,&quot;Excess&quot;:&quot;${excess}&quot;,&quot;CancellationCover&quot;:&quot;${defaultCancellation}&quot;,&quot;ProductCode&quot;:&quot;ST&quot;,&quot;SchsDiscount&quot;:${discount},&quot;MopedCover&quot;:false,&quot;CruiseCover&quot;:false,&quot;SkiCover&quot;:false}</stringProp>
