<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SCTI booking journey">
      <stringProp name="TestPlan.comments">Run with a load profile: jmeter -n -t booking-journey.jmx -q profiles/&lt;profile&gt;.properties -l results/&lt;profile&gt;.jtl -e -o results/&lt;profile&gt;-report</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,insure.scti.co.nz)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUN_ID" elementType="Argument">
            <stringProp name="Argument.name">RUN_ID</stringProp>
            <stringProp name="Argument.value">${__P(run.id,${__time(yyyyMMdd-HHmmss,)})}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="QUOTE_ABOVE" elementType="Argument">
            <stringProp name="Argument.name">QUOTE_ABOVE</stringProp>
            <stringProp name="Argument.value">${__P(funnel.quote.above,15)}</stringProp>
            <stringProp name="Argument.desc">Journeys whose funnel number (1-100) is above this get a quote: 85%</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CUSTOMISE_ABOVE" elementType="Argument">
            <stringProp name="Argument.name">CUSTOMISE_ABOVE</stringProp>
            <stringProp name="Argument.value">${__P(funnel.customise.above,50)}</stringProp>
            <stringProp name="Argument.desc">Above this they customise the plan: 50%</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SELECT_ABOVE" elementType="Argument">
            <stringProp name="Argument.name">SELECT_ABOVE</stringProp>
            <stringProp name="Argument.value">${__P(funnel.select.above,70)}</stringProp>
            <stringProp name="Argument.desc">Above this they go on to traveller details: 30%</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_HOME_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_HOME_MS</stringProp>
            <stringProp name="Argument.value">${__groovy(Math.round(30000 * (props.get(&apos;think.scale&apos;) ?: &apos;1&apos;).toDouble()))}</stringProp>
            <stringProp name="Argument.desc">Filling in destinations, dates and travellers</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_PLANS_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_PLANS_MS</stringProp>
            <stringProp name="Argument.value">${__groovy(Math.round(20000 * (props.get(&apos;think.scale&apos;) ?: &apos;1&apos;).toDouble()))}</stringProp>
            <stringProp name="Argument.desc">Comparing plans</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_CHANGE_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_CHANGE_MS</stringProp>
            <stringProp name="Argument.value">${__groovy(Math.round(8000 * (props.get(&apos;think.scale&apos;) ?: &apos;1&apos;).toDouble()))}</stringProp>
            <stringProp name="Argument.desc">Before each plan change</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THINK_TRAVELLERS_MS" elementType="Argument">
            <stringProp name="Argument.name">THINK_TRAVELLERS_MS</stringProp>
            <stringProp name="Argument.value">${__groovy(Math.round(150000 * (props.get(&apos;think.scale&apos;) ?: &apos;1&apos;).toDouble()))}</stringProp>
            <stringProp name="Argument.desc">Eligibility, declarations and 3 traveller forms; the site gets no requests</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">10000</intProp>
        <intProp name="HTTPSampler.response_timeout">60000</intProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
