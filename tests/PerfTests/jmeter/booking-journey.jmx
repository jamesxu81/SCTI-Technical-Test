        <stringProp name="TestPlan.comments">Each arrival is one visitor doing one journey. The arrival rate comes from the profile&apos;s schedule property.</stringProp>
        <stringProp name="OpenModelThreadGroup.schedule">${__P(schedule)}</stringProp>
        <stringProp name="OpenModelThreadGroup.random_seed">${__P(random.seed,0)}</stringProp>
